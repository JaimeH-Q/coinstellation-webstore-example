# ============================================================================
# Integración con Coinstellation
# Copia este archivo a .env.local y completa los valores. Reinicia la tienda
# después de cambiarlos. Estas variables se usan SOLO en el servidor de la
# tienda: nunca las renombres a NEXT_PUBLIC_* (la API key quedaría expuesta).
# ============================================================================

# URL del servidor de Coinstellation (sin barra al final).
# Es la que muestra el panel en Dashboard → API → "Endpoint Base".
COINSTELLATION_API_URL=http://129.151.100.83:25571

# API key de tu cuenta (cs_live_…). Se genera en Dashboard → API.
COINSTELLATION_API_KEY=

# Tu wallet pública de Stellar (G…) donde recibes los pagos.
# Es la que configuraste en Dashboard → Billetera.
COINSTELLATION_WALLET=GBKXUWGAZQFANMP5UO4NDY5KH5ZESI3RMX7LFLADRW7GHMSP6GIL3JQN
